# Bu faylni .env deb nusxalang va qiymatlarni to'ldiring. .env gitga TUSHMAYDI.

POSTGRES_DB=voltstream
POSTGRES_USER=voltstream
POSTGRES_PASSWORD=
# Baza faqat serverning o'zidan ko'rinadi (127.0.0.1), tashqariga ochilmaydi
POSTGRES_PORT=5432

# Kamida 32 belgi, tasodifiy. Yangilash: openssl rand -base64 48
# Kalit o'zgarsa barcha tokenlar bekor bo'ladi va hamma qayta login qiladi.
JWT_SECRET=

# cloudflared shu portga ulanadi
API_PORT=5000

TZ=Asia/Tashkent
