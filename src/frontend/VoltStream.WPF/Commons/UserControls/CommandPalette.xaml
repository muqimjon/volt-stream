<UserControl
    x:Class="VoltStream.WPF.Commons.UserControls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:loc="clr-namespace:VoltStream.WPF.Commons.Localization"
    x:Name="root"
    IsVisibleChanged="Root_IsVisibleChanged"
    Visibility="{Binding IsPaletteOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

    <Grid>
        <Border Background="#66000000" MouseDown="Scrim_MouseDown" />

        <Border
            Width="560"
            MaxHeight="440"
            Margin="0,90,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="14">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    Direction="270"
                    Opacity="0.35"
                    ShadowDepth="6"
                    Color="#000000" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,14,16,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <fa:IconImage
                        Grid.Column="0"
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Icon="MagnifyingGlass" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource TextTertiary}"
                        IsHitTestVisible="False"
                        Panel.ZIndex="1"
                        Text="{loc:Loc Palette.Placeholder}"
                        Visibility="{Binding ElementName=SearchBox, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBox
                        x:Name="SearchBox"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Padding="0"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="{DynamicResource Brand}"
                        FontSize="16"
                        Foreground="{DynamicResource TextPrimary}"
                        PreviewKeyDown="SearchBox_PreviewKeyDown"
                        Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Height="1"
                    Background="{DynamicResource Border}" />

                <ListBox
                    x:Name="ResultsList"
                    Grid.Row="2"
                    Margin="8"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding PaletteResults}"
                    PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedIndex="{Binding PaletteSelectedIndex, Mode=TwoWay}"
                    SelectionChanged="ResultsList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border
                                            x:Name="bd"
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="12,10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandSubtle}" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsMouseOver" Value="True" />
                                                    <Condition Property="IsSelected" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <fa:IconImage
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brand}"
                                    Icon="{Binding Icon}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{Binding Title}" />
                                <fa:IconImage
                                    Grid.Column="2"
                                    Width="11"
                                    Height="11"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextTertiary}"
                                    Icon="ArrowRight" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource TextTertiary}"
                    Text="{loc:Loc Palette.Empty}"
                    Visibility="{Binding PaletteResults.Count, Converter={StaticResource CountToEmptyVisibility}}" />

                <Border
                    Grid.Row="3"
                    Background="{DynamicResource SurfaceAlt}"
                    CornerRadius="0,0,13,13">
                    <StackPanel
                        Margin="14,8"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <TextBlock
                            Foreground="{DynamicResource TextTertiary}"
                            Text="↑↓" />
                        <TextBlock
                            Margin="6,0,16,0"
                            Foreground="{DynamicResource TextTertiary}"
                            Text="{loc:Loc Palette.Select}" />
                        <TextBlock
                            Foreground="{DynamicResource TextTertiary}"
                            Text="↵" />
                        <TextBlock
                            Margin="6,0,16,0"
                            Foreground="{DynamicResource TextTertiary}"
                            Text="{loc:Loc Palette.Open}" />
                        <TextBlock
                            Foreground="{DynamicResource TextTertiary}"
                            Text="Esc" />
                        <TextBlock
                            Margin="6,0,0,0"
                            Foreground="{DynamicResource TextTertiary}"
                            Text="{loc:Loc Common.Close}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
