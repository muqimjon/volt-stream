<UserControl x:Class="VoltStream.WPF.Settings.Views.Modules.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:VoltStream.WPF.Commons.Localization"
             xmlns:uc="clr-namespace:VoltStream.WPF.Commons.UserControls">
	<Grid Margin="20" Background="{DynamicResource Canvas}">
		<Border Style="{StaticResource CardBorder}"
                MaxWidth="560"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
			<StackPanel>
				<CheckBox Content="{loc:Loc Settings.AllowNegativeStock}"
                          IsChecked="{Binding AllowNegativeStock}"
                          Style="{StaticResource ModernCheck}" />

				<TextBlock Text="{loc:Loc Settings.AllowNegativeStockHint}"
                           Foreground="{DynamicResource TextSecondary}"
                           TextWrapping="Wrap"
                           Margin="28,6,0,0" />

				<Button Content="{loc:Loc Common.Save}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}"
                        HorizontalAlignment="Right"
                        Width="120"
                        Margin="0,20,0,0" />
			</StackPanel>
		</Border>

		<uc:BusyOverlay IsBusy="{Binding IsLoading}"
                        Message="{loc:Loc Common.Loading}" />
	</Grid>
</UserControl>
