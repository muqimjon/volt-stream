<Page x:Name="RootPage"
      x:Class="VoltStream.WPF.Settings.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:modules="clr-namespace:VoltStream.WPF.Settings.Views.Modules"
      xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
      xmlns:loc="clr-namespace:VoltStream.WPF.Commons.Localization"
      xmlns:utils="clr-namespace:VoltStream.WPF.Commons.Utils"
      Background="{DynamicResource Canvas}"
      Title="{loc:Loc Nav.Settings}">
	<Grid Margin="10">
		<TabControl x:Name="SettingsTabControl" FontSize="{DynamicResource FontSizeBody}">

			<TabItem>
				<TabItem.Header>
					<StackPanel Orientation="Horizontal">
						<fa:IconImage Icon="Plug" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
						<TextBlock Text="{loc:Loc Settings.TabConnection}" VerticalAlignment="Center" />
					</StackPanel>
				</TabItem.Header>
				<modules:ConnectionSettingsView DataContext="{Binding ApiConnection}" />
			</TabItem>

			<TabItem utils:Permission.Require="settings.currencies">
				<TabItem.Header>
					<StackPanel Orientation="Horizontal">
						<fa:IconImage Icon="Coins" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
						<TextBlock Text="{loc:Loc Settings.TabCurrencies}" VerticalAlignment="Center" />
					</StackPanel>
				</TabItem.Header>
				<modules:CurrencySettingsView DataContext="{Binding ElementName=RootPage, Path=DataContext}" />
			</TabItem>

			<TabItem utils:Permission.Require="settings.categories">
				<TabItem.Header>
					<StackPanel Orientation="Horizontal">
						<fa:IconImage Icon="Tags" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
						<TextBlock Text="{loc:Loc Settings.TabCategories}" VerticalAlignment="Center" />
					</StackPanel>
				</TabItem.Header>
				<modules:CategorySettingsView DataContext="{Binding ElementName=RootPage, Path=DataContext.CategorySettings}" />
			</TabItem>

			<TabItem utils:Permission.Require="settings.products">
				<TabItem.Header>
					<StackPanel Orientation="Horizontal">
						<fa:IconImage Icon="Boxes" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
						<TextBlock Text="{loc:Loc Settings.TabProducts}" VerticalAlignment="Center" />
					</StackPanel>
				</TabItem.Header>
				<modules:ProductSettingsView DataContext="{Binding ElementName=RootPage, Path=DataContext.ProductSettings}" />
			</TabItem>

			<TabItem utils:Permission.Require="settings.customers">
				<TabItem.Header>
					<StackPanel Orientation="Horizontal">
						<fa:IconImage Icon="Users" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
						<TextBlock Text="{loc:Loc Settings.TabCustomers}" VerticalAlignment="Center" />
					</StackPanel>
				</TabItem.Header>
				<modules:CustomerSettingsView DataContext="{Binding ElementName=RootPage, Path=DataContext.CustomerSettings}" />
			</TabItem>

			<TabItem utils:Permission.Require="settings.branches">
				<TabItem.Header>
					<StackPanel Orientation="Horizontal">
						<fa:IconImage Icon="CodeBranch" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
						<TextBlock Text="{loc:Loc Settings.TabBranches}" VerticalAlignment="Center" />
					</StackPanel>
				</TabItem.Header>
				<modules:BranchSettingsView DataContext="{Binding ElementName=RootPage, Path=DataContext.BranchSettings}" />
			</TabItem>

			<TabItem utils:Permission.Require="settings.users">
				<TabItem.Header>
					<StackPanel Orientation="Horizontal">
						<fa:IconImage Icon="UserGear" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center"
                                      Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
						<TextBlock Text="{loc:Loc Settings.TabUsers}" VerticalAlignment="Center" />
					</StackPanel>
				</TabItem.Header>
				<modules:UserSettingsView DataContext="{Binding ElementName=RootPage, Path=DataContext.UserSettings}" />
			</TabItem>

		</TabControl>
	</Grid>
</Page>
