<Page
    x:Class="VoltStream.WPF.Sales.Views.SalesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:VoltStream.WPF.Commons.UserControls"
    xmlns:converter="clr-namespace:VoltStream.WPF.Commons.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:loc="clr-namespace:VoltStream.WPF.Commons.Localization"
    xmlns:local="clr-namespace:VoltStream.WPF.Sales.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:VoltStream.WPF.Supplies.Models"
    xmlns:utils="clr-namespace:VoltStream.WPF.Commons.Utils"
    Title="SalesPage"
    d:DesignHeight="450"
    d:DesignWidth="1100"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Grid Margin="10" Background="{DynamicResource Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,4" Margin="0,0,0,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="500" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                    </Grid.RowDefinitions>
                    <Label
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Content="{loc:Loc Sales.DateLabel}"
                        FontSize="14" />
                    <Label
                        Grid.Row="1"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Content="{loc:Loc Sales.CustomerLabel}"
                        FontSize="14" />
                    <Label
                        Grid.Row="2"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Content="{loc:Loc Sales.CurrencyTypeLabel}"
                        FontSize="14" />
                    <Label
                        x:Name="lblDiscountRow"
                        Grid.Row="3"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Content="{loc:Loc Sales.DiscountLabel}"
                        FontSize="14" />
                    <Label
                        Grid.Row="4"
                        Margin="5,0,0,0"
                        VerticalAlignment="Center"
                        Content="{loc:Loc Sales.NoteLabel}"
                        FontSize="14" />
                    <Grid Grid.Row="0" Grid.Column="1">
                        <controls:UserCalendar
                            x:Name="saleDate"
                            Width="150"
                            Margin="0,2,10,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            utils:EnterKeyTab.IsEnabled="True"
                            FontSize="14"
                            LostFocus="SupplyDate_LostFocus"
                            SelectedDate="{Binding OperationDate, Mode=TwoWay}" />
                    </Grid>
                    <Grid Grid.Row="1" Grid.Column="1">
                        <ComboBox
                            x:Name="CustomerName" Height="28" Style="{StaticResource RoundedCombo}"
                            Margin="0,2,0,2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            utils:ComboBoxQuickNavBehavior.EnableQuickNavigation="True"
                            AutomationProperties.Name="{loc:Loc Sales.CustomerLabel}"
                            FontSize="14"
                            IsEditable="True"
                            Text="{Binding CustomerName}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ModernComboItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                    </Grid>
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="CurrencyType" Height="28" Style="{StaticResource RoundedCombo}"
                            Margin="0,2,10,2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            DisplayMemberPath="Name"
                            FontSize="14"
                            IsEditable="True"
                            IsHitTestVisible="False"
                            IsReadOnly="True"
                            IsTabStop="False" />

                        <Label
                            x:Name="lblTotalSum"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="{loc:Loc Sales.TotalSumLabel}"
                            FontSize="14" />
                        <TextBox
                            x:Name="TotalSum" Style="{StaticResource ReadOnlyValue}"
                            Grid.Column="2"
                            Height="28"
                            Margin="0,2,0,0"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Right"
                            utils:NumericTextBox.IsNumeric="True"
                            utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                            FontSize="14"
                            Text="{Binding TotalSum}" />
                    </Grid>
                    <Grid x:Name="discountPanel" Grid.Row="3" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="txtTotalDiscount" Style="{StaticResource ReadOnlyValue}"
                                Height="28"
                                Margin="0,2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Right"
                                utils:NumericTextBox.IsNumeric="True"
                                utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                                FontSize="14"
                                Text="{Binding TotalDiscount}" />
                            <Border
                                Grid.Column="1"
                                Height="28"
                                Margin="2,2,10,2"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <CheckBox
                                    x:Name="checkedDiscount"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    utils:EnterKeyTab.IsEnabled="True"
                                    Click="CheckedDiscount_Click"
                                    Style="{StaticResource ModernCheck}"
                                    IsChecked="{Binding IsDiscountApplied}" />
                            </Border>
                        </Grid>
                        <Label
                            Grid.Column="1"
                            Margin="1,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{loc:Loc Sales.ToPayLabel}"
                            FontSize="14" />
                        <TextBox
                            x:Name="FinalSumm" Style="{StaticResource ReadOnlyValue}"
                            Grid.Column="2"
                            Margin="0,2"
                            Height="28"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Right"
                            utils:NumericTextBox.IsNumeric="True"
                            utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                            FontSize="14"
                            Text="{Binding FinalSum}" />


                    </Grid>
                    <Grid Grid.Row="4" Grid.Column="1">
                        <TextBox
                            x:Name="noteTextBox" Height="28" Style="{StaticResource RoundedTextBox}"
                            Margin="0,1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                            FontSize="14"
                            Text="{Binding Description}" />
                    </Grid>
                </Grid>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="40" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontStyle="Italic"
                            FontWeight="Bold"
                            Text="{loc:Loc Sales.AccountLabel}"
                            Visibility="{Binding ElementName=beginBalans, Path=Text.IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <TextBlock
                            Grid.Row="1"
                            VerticalAlignment="Center"
                            Text="{loc:Loc Sales.CurrentLabel}"
                            Visibility="{Binding ElementName=beginBalans, Path=Text.IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <TextBox
                            x:Name="beginBalans" Foreground="{DynamicResource TextPrimary}"
                            Grid.Row="1"
                            Margin="35,2,2,2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            utils:NumericTextBox.IsNumeric="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            IsReadOnly="True"
                            IsTabStop="False" />
                        <TextBlock
                            Grid.Row="2"
                            VerticalAlignment="Center"
                            Text="{loc:Loc Sales.ResultLabel}"
                            Visibility="{Binding ElementName=lastBalans, Path=Text.IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <TextBox
                            x:Name="lastBalans" Foreground="{DynamicResource TextPrimary}"
                            Grid.Row="2"
                            Margin="35,2,2,2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Right"
                            utils:NumericTextBox.IsNumeric="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            IsReadOnly="True"
                            IsTabStop="False" />
                        <TextBlock
                            Grid.Row="3"
                            VerticalAlignment="Center"
                            Text="{loc:Loc Sales.PhoneLabel}"
                            Visibility="{Binding ElementName=tel, Path=Text.IsEmpty, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <TextBox
                            x:Name="tel" Foreground="{DynamicResource TextPrimary}"
                            Grid.Row="3"
                            Margin="42,2,2,2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="12"
                            IsReadOnly="True"
                            IsTabStop="False" />
                        <Grid Grid.Row="4" />

                    </Grid>

                </Grid>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0 12 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition x:Name="colPrice" Width="*" />
                <ColumnDefinition x:Name="colSum" Width="1.2*" />
                <ColumnDefinition x:Name="colPerDiscount" Width="0.75*" />
                <ColumnDefinition x:Name="colDiscount" Width="*" />
                <ColumnDefinition x:Name="colFinalSum" Width="1.1*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=cbxCategoryName}"
                Text="{loc:Loc Sales.ProductType}" />
            <ComboBox
                x:Name="cbxCategoryName" Style="{StaticResource RoundedCombo}"
                Margin="1,3"
                utils:ComboBoxQuickNavBehavior.EnableQuickNavigation="True"
                FontSize="14"
                IsEditable="True"
                Text="{Binding CategoryName}" />
            <TextBlock
                Grid.Column="1"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=cbxProductName}"
                Text="{loc:Loc Sales.ProductName}" />
            <ComboBox
                x:Name="cbxProductName" Style="{StaticResource RoundedCombo}"
                Grid.Column="1"
                Margin="1,3"
                utils:ComboBoxQuickNavBehavior.EnableQuickNavigation="True"
                FontSize="14"
                IsEditable="True"
                Text="{Binding ProductName}" />
            <TextBlock
                Grid.Column="2"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=cbxPerRollCount}"
                Text="{loc:Loc Sales.PerRoll}" />
            <ComboBox
                x:Name="cbxPerRollCount" Style="{StaticResource RoundedCombo}"
                Grid.Column="2"
                Margin="2,3"
                utils:ComboBoxQuickNavBehavior.EnableQuickNavigation="True"
                FontSize="14"
                IsEditable="True"
                Text="{Binding PerRollCount}" />
            <TextBlock
                Grid.Column="3"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=txtRollCount}"
                Text="{loc:Loc Sales.RollCount}" />
            <TextBox
                x:Name="txtRollCount" Style="{StaticResource RoundedTextBox}"
                Grid.Column="3"
                Margin="1,3"
                utils:NumericTextBox.DecimalDigits="0"
                utils:NumericTextBox.IsNumeric="True"
                utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                FontSize="14"
                Text="{Binding RollCount}" />
            <TextBlock
                Grid.Column="4"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=txtQuantity}"
                Text="{loc:Loc Common.Total}" />
            <TextBox
                x:Name="txtQuantity" Style="{StaticResource RoundedTextBox}"
                Grid.Column="4"
                Margin="1,3"
                utils:NumericTextBox.IsNumeric="True"
                utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                FontSize="14"
                Text="{Binding Quantity}" />
            <TextBlock
                x:Name="lbPrice"
                Grid.Column="5"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=txtPrice}"
                Text="{loc:Loc Common.Price}" />
            <TextBox
                x:Name="txtPrice" Style="{StaticResource RoundedTextBox}"
                Grid.Column="5"
                Margin="1,3"
                utils:NumericTextBox.IsNumeric="True"
                utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                FontSize="14"
                Text="{Binding Price}" />
            <TextBlock
                x:Name="lbSum"
                Grid.Column="6"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=txtSum}"
                Text="{loc:Loc Sales.TotalSum}" />
            <TextBox
                x:Name="txtSum" Style="{StaticResource RoundedTextBox}"
                Grid.Column="6"
                Margin="1,3"
                utils:NumericTextBox.IsNumeric="True"
                utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                FontSize="14"
                Text="{Binding Sum}" />
            <TextBlock
                x:Name="lbPerDiscount"
                Grid.Column="7"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=txtPerDiscount}"
                Text="{loc:Loc Sales.DiscountPercent}" />
            <TextBox
                x:Name="txtPerDiscount" Style="{StaticResource RoundedTextBox}"
                Grid.Column="7"
                Margin="1,3"
                utils:NumericTextBox.IsNumeric="True"
                utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                FontSize="14"
                Text="{Binding PerDiscount}" />
            <TextBlock
                x:Name="lbDiscount"
                Grid.Column="8"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=txtDiscount}"
                Text="{loc:Loc Sales.DiscountAmount}" />
            <TextBox
                x:Name="txtDiscount" Style="{StaticResource RoundedTextBox}"
                Grid.Column="8"
                Margin="1,3"
                utils:NumericTextBox.IsNumeric="True"
                utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                FontSize="14"
                Text="{Binding Discount}" />
            <TextBlock
                x:Name="lbFinalSum"
                Grid.Column="9"
                Panel.ZIndex="1"
                IsHitTestVisible="False"
                Style="{StaticResource FloatingLabelStyle}"
                Tag="{Binding ElementName=txtFinalSumProduct}"
                Text="{loc:Loc Sales.GrandTotal}" />
            <TextBox
                x:Name="txtFinalSumProduct" Style="{StaticResource RoundedTextBox}"
                Grid.Column="9"
                Margin="1,3"
                utils:NumericTextBox.IsNumeric="True"
                utils:TextBoxTabBehavior.EnableTabOnKeys="True"
                FontSize="14"
                Text="{Binding FinalSumProduct}" />
            <Button
                x:Name="addButton" Style="{StaticResource RoundedButton}"
                Grid.Column="10"
                Width="90"
                Margin="4 3 0 3"
                Background="{DynamicResource Brand}"
                Foreground="{DynamicResource OnBrand}"
                Click="AddButton_Click"
                FontSize="14">
                <TextBlock Text="{loc:Loc Common.Add}" Foreground="White" />
            </Button>
        </Grid>
        <Grid Grid.Row="2" Margin="0 2 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <DataGrid
                    x:Name="dataGrid"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="True"
                    FontSize="14"
                    ItemsSource="{Binding SaleItems}"
                    SelectionMode="Single"
                    HeadersVisibility="Column, Row"
                    RowHeaderWidth="40"
                    utils:DataGridExcelEditing.IsEnabled="True"
                    utils:DataGridRowNumbering.IsEnabled="True"
                    CellEditEnding="DataGrid_CellEditEnding"
                    SelectionUnit="CellOrRowHeader">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="1.5*" MinWidth="120" IsReadOnly="True" Binding="{Binding CategoryName}" Header="{loc:Loc Sales.ProductType}" />
                        <DataGridTextColumn
                            Width="1.8*"
                            MinWidth="120"
                            IsReadOnly="True"
                            Binding="{Binding ProductName}"
                            Header="{loc:Loc Sales.ProductName}" />
                        <DataGridTextColumn
                            Width="*"
                            IsReadOnly="True"
                            Binding="{Binding PerRollCount}"
                            ElementStyle="{StaticResource RightCellText}"
                                    HeaderStyle="{StaticResource RightColumnHeader}"
                            Header="{loc:Loc Sales.PerRoll}" />
                        <utils:ManualCommitTextColumn
                            x:Name="rollCountColumn"
                            Width="*"
                            Binding="{Binding RollCount, Mode=OneWay, Converter={StaticResource ToStringConverter}}"
                            ElementStyle="{StaticResource RightCellText}"
                            EditingElementStyle="{StaticResource GridEditInteger}"
                                    HeaderStyle="{StaticResource RightColumnHeader}"
                            Header="{loc:Loc Sales.RollCount}" />
                        <utils:ManualCommitTextColumn
                            x:Name="quantityColumn"
                            Width="*"
                            Binding="{Binding Quantity, Mode=OneWay, Converter={StaticResource ToStringConverter}}"
                            ElementStyle="{StaticResource RightCellText}"
                            EditingElementStyle="{StaticResource GridEditText}"
                                    HeaderStyle="{StaticResource RightColumnHeader}"
                            Header="{loc:Loc Common.Total}" />
                        <DataGridTextColumn
                            x:Name="weightColumn"
                            Width="*"
                            IsReadOnly="True"
                            Binding="{Binding Weight, StringFormat={}{0:N3}}"
                            ElementStyle="{StaticResource RightCellText}"
                            HeaderStyle="{StaticResource RightColumnHeader}"
                            Header="{loc:Loc SalesJournal.Weight}"
                            Visibility="Collapsed" />
                        <utils:ManualCommitTextColumn
                            x:Name="priceColumn"
                            Width="*"
                            Binding="{Binding Price, Mode=OneWay, Converter={StaticResource ToStringConverter}}"
                            ElementStyle="{StaticResource RightCellText}"
                            EditingElementStyle="{StaticResource GridEditText}"
                                    HeaderStyle="{StaticResource RightColumnHeader}"
                            Header="{loc:Loc Common.Price}" />
                        <DataGridTextColumn
                            x:Name="sumColumn"
                            Width="*"
                            IsReadOnly="True"
                            Binding="{Binding Sum, Converter={StaticResource ToStringConverter}}"
                            ElementStyle="{StaticResource RightCellText}"
                                    HeaderStyle="{StaticResource RightColumnHeader}"
                            Header="{loc:Loc Sales.TotalSum}" />
                        <utils:ManualCommitTextColumn
                            x:Name="perDiscountColumn"
                            Width="*"
                            Binding="{Binding PerDiscount, Mode=OneWay, Converter={StaticResource ToStringConverter}}"
                            ElementStyle="{StaticResource RightCellText}"
                            EditingElementStyle="{StaticResource GridEditText}"
                                    HeaderStyle="{StaticResource RightColumnHeader}"
                            Header="{loc:Loc Sales.DiscountPercent}" />
                        <DataGridTextColumn
                            x:Name="discountColumn"
                            Width="*"
                            IsReadOnly="True"
                            Binding="{Binding Discount, Converter={StaticResource ToStringConverter}}"
                            ElementStyle="{StaticResource RightCellText}"
                                    HeaderStyle="{StaticResource RightColumnHeader}"
                            Header="{loc:Loc Sales.DiscountAmount}" />
                        <DataGridTextColumn
                            x:Name="finalSumColumn"
                            Width="*"
                            IsReadOnly="True"
                            Binding="{Binding FinalSumProduct, Converter={StaticResource ToStringConverter}}"
                            ElementStyle="{StaticResource RightCellText}"
                                    HeaderStyle="{StaticResource RightColumnHeader}"
                            Header="{loc:Loc Sales.GrandTotal}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
            <Grid Grid.Row="1">
                <Button
                    x:Name="receiptButton"
                    Margin="0 10 0 0"
                    Padding="14,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Click="ReceiptButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryButton}"
                    FontSize="14">
                    <StackPanel Orientation="Horizontal">
                        <fa:IconImage
                            Width="14"
                            Height="14"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brand}"
                            Icon="Receipt" />
                        <TextBlock
                            x:Name="receiptButtonText"
                            VerticalAlignment="Center"
                            Text="{loc:Loc Receipt.Show}" />
                    </StackPanel>
                </Button>

                <TextBlock
                    Margin="0 10 0 0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Warning}"
                    Text="{Binding DraftLabel}"
                    Visibility="{Binding DraftLabel, Converter={StaticResource StringToVisibilityConverter}}" />

                <StackPanel
                    Margin="0 10 0 0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,6,0"
                        Padding="14,0"
                        Click="ClearButton_Click"
                        Content="{loc:Loc Common.Clear}"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="14" />

                    <Button
                        Padding="18,0"
                        Click="SubmitButton_Click"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="14">
                        <TextBlock Text="{loc:Loc Sales.Submit}" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
