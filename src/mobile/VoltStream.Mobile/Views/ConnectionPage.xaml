<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VoltStream.Mobile"
             x:Class="VoltStream.Mobile.Views.ConnectionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="24,56,24,24" Spacing="12">
            <Label Text="Volt Stream" FontSize="26" FontAttributes="Bold" TextColor="#4F46E5"
                   HorizontalOptions="Center" Margin="0,0,0,16" />

            <Label Text="{x:Static local:Texts.PrimaryUrl}" />
            <Entry x:Name="primary" Keyboard="Url" Placeholder="http://192.168.100.168:5000" />

            <Label Text="{x:Static local:Texts.BackupUrl}" />
            <Entry x:Name="backup" Keyboard="Url" Placeholder="https://volt.domen.uz" />

            <Label x:Name="status" Margin="0,8,0,0" />

            <Button Text="{x:Static local:Texts.Check}" Clicked="OnCheck"
                    BackgroundColor="Transparent" TextColor="#4F46E5"
                    BorderColor="#4F46E5" BorderWidth="1" />
            <Button Text="{x:Static local:Texts.Save}" Clicked="OnSave"
                    BackgroundColor="#4F46E5" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
