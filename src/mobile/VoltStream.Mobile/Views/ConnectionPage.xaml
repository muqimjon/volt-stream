<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VoltStream.Mobile"
             x:Class="VoltStream.Mobile.Views.ConnectionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#0F1420}">
    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#E6E9F0}" />
        </Style>
        <Style TargetType="Entry">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1F2937, Dark=#E6E9F0}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#9AA4B2, Dark=#6B7686}" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="24,24,24,24" Spacing="12">
            <Label Text="Volt Stream" FontSize="26" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#4F46E5, Dark=#6366F1}"
                   HorizontalOptions="Center" Margin="0,32,0,16" />

            <Label Text="{x:Static local:Texts.PrimaryUrl}" />
            <Entry x:Name="primary" Keyboard="Url" Placeholder="http://192.168.100.168:5000" />

            <Label Text="{x:Static local:Texts.BackupUrl}" />
            <Entry x:Name="backup" Keyboard="Url" Placeholder="https://volt.domen.uz" />

            <Label x:Name="status" Margin="0,8,0,0" />

            <Button Text="{x:Static local:Texts.Check}" Clicked="OnCheck"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#4F46E5, Dark=#818CF8}"
                    BorderColor="{AppThemeBinding Light=#4F46E5, Dark=#818CF8}" BorderWidth="1" />
            <Button Text="{x:Static local:Texts.Save}" Clicked="OnSave"
                    BackgroundColor="#4F46E5" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
